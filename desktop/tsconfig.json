{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "chrome"],
    "baseUrl": ".",
    "paths": {
      "~sync/*": ["../src/sync/*"],
      "~background/*": ["../src/background/*"],
      "~contents/*": ["../src/contents/*"],
      "turndown": ["./node_modules/@types/turndown/index.d.ts"]
    }
  },
  "include": ["src/**/*", "src/types.d.ts"]
}
